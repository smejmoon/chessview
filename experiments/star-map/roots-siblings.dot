digraph G {
  graph [rankdir=LR, bgcolor="#17202b", pad="0.3", nodesep="0.28", ranksep="0.55", splines=true, outputorder=edgesfirst];
  node [fontname="DejaVu Sans", fontsize=10, style=filled, penwidth=1.5, color="#98a7b6", fontcolor="#e8edf3"];
  edge [color="#627b95", arrowsize=0.45, penwidth=1.3];
  "Root1" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "Root2" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "N" [shape=box, fixedsize=true, width=1.60, height=1.60, fillcolor="#286ca0", label="N"];
  "r1siblings" [shape=box, fixedsize=true, width=1.1, height=1.1, fillcolor="#346e6d", label="r1siblings"];
  "r2siblings" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "after" [shape=box, fixedsize=true, width=1.1, height=1.1, fillcolor="#346e6d", label="after"];
  "a2" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "Root1" -> "N";
  "Root2" -> "N";
  "Root1" -> "r1siblings";
  "Root2" -> "r2siblings";
  "N" -> "after";
  "after" -> "a2";
}
