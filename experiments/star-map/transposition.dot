digraph G {
  graph [rankdir=LR, bgcolor="#17202b", pad="0.3", nodesep="0.28", ranksep="0.55", splines=true, outputorder=edgesfirst];
  node [fontname="DejaVu Sans", fontsize=10, style=filled, penwidth=1.5, color="#98a7b6", fontcolor="#e8edf3"];
  edge [color="#627b95", arrowsize=0.45, penwidth=1.3];
  "N" [shape=box, fixedsize=true, width=1.60, height=1.60, fillcolor="#286ca0", label="N"];
  "d4" [shape=box, fixedsize=true, width=1.1, height=1.1, fillcolor="#346e6d", label="d4"];
  "Nf3" [shape=box, fixedsize=true, width=1.1, height=1.1, fillcolor="#346e6d", label="Nf3"];
  "d4_Nf6" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "d4_Nf3" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "Nf3_d5" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "Nf3_d4" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "merge" [shape=box, fixedsize=true, width=1.1, height=1.1, fillcolor="#346e6d", label="merge"];
  "other" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "deep" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "deep2" [shape=circle, fixedsize=true, width=0.18, height=0.18, fillcolor="#9aaabc", label=""];
  "N" -> "d4";
  "N" -> "Nf3";
  "d4" -> "d4_Nf6";
  "d4_Nf6" -> "d4_Nf3";
  "Nf3" -> "Nf3_d5";
  "Nf3_d5" -> "Nf3_d4";
  "d4_Nf3" -> "merge";
  "Nf3_d4" -> "merge";
  "merge" -> "deep";
  "deep" -> "deep2";
  "d4" -> "other";
}
